# Server Configuration
PORT=8080

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DATABASE=resume_builder

# JWT Authentication
# Generate a secure 256-bit or 512-bit hex/base64 string
JWT_SECRET=replace_with_secure_secret_at_least_32_characters_long
JWT_EXPIRATION=86400000

# CORS / Frontend URL
FRONTEND_URL=http://localhost:5173

# AI Provider Configuration ('gemini' or 'openai')
AI_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API (Optional if using Gemini)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
